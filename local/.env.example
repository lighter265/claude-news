# local/.env にコピーして値を埋める(.env は .gitignore 対象)。
# Gmail/Google Workspace のアプリパスワード(16桁・スペース無し)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 任意: 送信元/先を上書きする場合(既定は info@blueskyjp.com)
# NEWS_MAIL_FROM=info@blueskyjp.com
# NEWS_MAIL_TO=info@blueskyjp.com

# 任意: donsetch バイナリのパス（未設定なら絶対パス既定を使用）
# DONSETCH_BIN=/home/lighter/.nvm/versions/node/v24.22.2/lib/node_modules/donsetch/binaries/donsetch
